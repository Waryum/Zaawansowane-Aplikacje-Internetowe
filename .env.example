// example configutration file

// database info, name, user, pass, host, port
// mariadb 11.4 + dbeaver for tests
// schema.sql required
DB_NAME=DB_TEST
DB_HOST=localhost
DB_PORT=3306
DB_USER=DB_TEST
DB_PASSWORD=YourPassword

// db user can SELECT, INSERT, UPDATE, DELETE

// admin account info

ADMIN_USERNAME=YourUsername
ADMIN_PASSWORD=YourPassword

